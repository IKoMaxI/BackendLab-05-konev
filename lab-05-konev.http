@Host = https://localhost:7087

### STUDENTS: список
GET {{Host}}/api/students
Accept: application/json

### STUDENTS: по id
GET {{Host}}/api/students/1
Accept: application/json

### STUDENTS: необязательный id — без id
GET {{Host}}/api/students/optional
Accept: application/json

### STUDENTS: необязательный id — с id
GET {{Host}}/api/students/optional/1
Accept: application/json

### STUDENTS: вложенный маршрут courses
GET {{Host}}/api/students/1/courses
Accept: application/json

### STUDENTS: query-фильтр по группе
GET {{Host}}/api/students/group?group=1
Accept: application/json

### STUDENTS: query page/pageSize/sort
GET {{Host}}/api/students/search?page=1&pageSize=10&sort=name
Accept: application/json

### STUDENTS: POST
POST {{Host}}/api/students
Content-Type: application/json

{
  "name": "Student Gamma",
  "group": 3,
  "specialization": "API",
  "courses": [
    { "id": 4, "title": "Routing" }
  ]
}

### STUDENTS: PUT
PUT {{Host}}/api/students/1
Content-Type: application/json

{
  "name": "Student Alpha",
  "group": 1,
  "specialization": "Backend Updated",
  "courses": [
    { "id": 1, "title": "ASP.NET Core" }
  ]
}

### STUDENTS: DELETE
DELETE {{Host}}/api/students/2

### PRODUCTS: список
GET {{Host}}/api/products
Accept: application/json

### PRODUCTS: id:int
GET {{Host}}/api/products/1
Accept: application/json

### PRODUCTS: name:minlength(3)
GET {{Host}}/api/products/by-name/phone
Accept: application/json

### PRODUCTS: slug:minlength(3)
GET {{Host}}/api/products/by-slug/phone
Accept: application/json

### PRODUCTS: guid:guid
GET {{Host}}/api/products/11111111-1111-1111-1111-111111111111
Accept: application/json

### PRODUCTS: POST
POST {{Host}}/api/products
Content-Type: application/json

{
  "name": "Tablet",
  "price": 30000
}

### PRODUCTS: PUT
PUT {{Host}}/api/products/1
Content-Type: application/json

{
  "name": "Phone Pro",
  "price": 60000
}

### PRODUCTS: DELETE
DELETE {{Host}}/api/products/2

### ORDERS: список
GET {{Host}}/api/orders
Accept: application/json

### ORDERS: id:int
GET {{Host}}/api/orders/1
Accept: application/json

### ORDERS: year:int
GET {{Host}}/api/orders/year/2024
Accept: application/json

### ORDERS: date:datetime
GET {{Host}}/api/orders/date/2024-03-10
Accept: application/json

### ORDERS: значение маршрута по умолчанию days=7
GET {{Host}}/api/orders/recent
Accept: application/json

### ORDERS: POST
POST {{Host}}/api/orders
Content-Type: application/json

{
  "title": "Order Gamma",
  "date": "2024-03-10T10:00:00",
  "price": 1800
}

### ORDERS: PUT
PUT {{Host}}/api/orders/1
Content-Type: application/json

{
  "title": "Order Alpha Updated",
  "date": "2024-03-10T12:00:00",
  "price": 1500
}

### ORDERS: DELETE
DELETE {{Host}}/api/orders/2
